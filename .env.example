# マネーフォワードID の認証情報(必須)
MF_SBI_EMAIL=your-email@example.com
MF_SBI_PASSWORD=your-password

# HTTP/SOCKS プロキシ(任意)
#MF_SBI_PROXY=http://127.0.0.1:8080

# 複数アカウントを切り替える際のプロファイル名(任意。CLI の --profile で上書き可)
# 指定するとセッション Cookie(.session/<profile>/cookies.json)と監査ログ
# (logs/<profile>/audit-YYYY-MM.log)がプロファイルごとに分離される
#MF_SBI_PROFILE=main
